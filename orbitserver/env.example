# ══════════════════════════════════════════════════════════════════════════════
#  ORBIT — environment template
#  Copy to .env  (cp .env.example .env)  →  every variable is Zod-validated at boot
#  The app REFUSES TO START on a missing/invalid value. Never commit a real .env.
# ══════════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=8010
APP_NAME=Orbit
APP_URL=http://localhost:5173
API_URL=http://localhost:8010
WEB_CONCURRENCY=0
LOG_LEVEL=debug
LOG_PRETTY=true
LOG_DEBUG_SAMPLE_RATE=1
GIT_SHA=
APP_VERSION=1.0.0
TRUST_PROXY=true

JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(96).toString('base64url'))">
JWT_ALGORITHM=HS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=orbit
JWT_AUDIENCE=orbit-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_TTL_REMEMBER=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CSRF_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=30
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=10

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_REQUIRE_TRANSACTIONS=true
MONGO_SLOW_QUERY_MS=200

REDIS_CACHE_URL=redis://:cache_pw@localhost:6379
REDIS_QUEUE_URL=redis://:queue_pw@localhost:6380
REDIS_KEY_PREFIX=orbit:dev
REDIS_CACHE_TTL_DEFAULT=300
CACHE_ENABLED=true
CACHE_SWR_SECONDS=1800

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=orbit
S3_SECRET_KEY=orbit_minio_pw
S3_BUCKET_PRIVATE=orbit-uploads-private
S3_BUCKET_PUBLIC=orbit-public-assets
S3_FORCE_PATH_STYLE=true
PRESIGN_EXPIRES_SECONDS=300
UPLOAD_MAX_SIZE_BYTES=26214400
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,image/webp,image/gif,application/pdf,text/plain,text/csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document
STORAGE_QUOTA_BYTES=1073741824

QUEUE_DISABLED=false
QUEUE_PREFIX=orbit
QUEUE_MAX_BACKPRESSURE=1000
DLQ_ENABLED=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Orbit <no-reply@orbit.dev>

SOCKET_PATH=/socket.io
SOCKET_CORS_ORIGINS=http://localhost:5173,http://localhost
SOCKET_MAX_BUFFER=65536
SOCKET_ROOM_LIMIT=50
SOCKET_RATE_LIMIT_EVENTS=20
PRESENCE_TTL_SECONDS=60
TYPING_TTL_SECONDS=4

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_ENABLED=true
METRICS_TOKEN=internal-scrape-token
HEALTH_DETAILED=true
OTEL_ENABLED=false

SEED_LARGE=false
SEED_DEMO_PASSWORD=Orbit@12345

VITE_API_URL=http://localhost/api/v1
VITE_SOCKET_URL=http://localhost
VITE_APP_VERSION=1.0.0
VITE_SENTRY_DSN=
VITE_FEATURE_ANALYTICS=true
VITE_FEATURE_OFFLINE=true
VITE_FEATURE_ADMIN_UI=true
