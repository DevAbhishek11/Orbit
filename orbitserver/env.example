NODE_ENV=development
PORT=8010
APP_URL=http://localhost:5173
API_URL=http://localhost:8010
# Generate with node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
COOKIE_DOMAIN=
COOKIE_SECURE=false
MONGODB_URI=mongodb://127.0.0.1:27017/orbit?replicaSet=rs0&directConnection=true
MONGO_DB_NAME=orbit
MONGO_REQUIRE_TRANSACTIONS=true
REDIS_CACHE_URL=redis://127.0.0.1:6379
REDIS_QUEUE_URL=redis://127.0.0.1:6380
REDIS_KEY_PREFIX=orbit:dev
QUEUE_DISABLED=true
LOG_LEVEL=info
LOG_PRETTY=true
WEB_CONCURRENCY=1
SEED_DEMO_PASSWORD=Orbit@1234567

# S3 / MinIO (files pillar)
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=orbit-files
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Mail (MailHog dev)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=Orbit <no-reply@orbit.dev>

# Metrics / observability
METRICS_ENABLED=true
METRICS_TOKEN=internal-scrape-token
