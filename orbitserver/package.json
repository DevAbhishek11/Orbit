{
  "name": "orbitserver",
  "version": "0.1.0",
  "private": true,
  "description": "Orbit API server — Express 5 + Mongoose 8 + Redis, layered modular architecture",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "dev:cluster": "tsx watch --clear-screen=false src/cluster.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:cluster": "node dist/cluster.js",
    "start:worker": "node dist/worker/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sync-indexes": "tsx scripts/syncIndexes.ts",
    "seed": "tsx scripts/seed.ts",
    "check-db": "tsx scripts/checkDb.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.21.3",
    "@bull-board/express": "^6.21.3",
    "@node-rs/argon2": "^2.0.2",
    "@orbit/shared": "*",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.81.5",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "nanoid": "^5.1.5",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.30.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
