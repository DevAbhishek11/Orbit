{
  "name": "orbit-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Orbit \u2014 Docs, Boards, Chat. One workspace. (npm workspaces monorepo)",
  "workspaces": [
    "shared",
    "orbitserver",
    "orbit"
  ],
  "scripts": {
    "dev": "npm run build:shared && concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace=orbitserver",
    "dev:web": "npm run dev --workspace=orbit",
    "build": "npm run build --workspace=shared && npm run build --workspace=orbitserver && npm run build --workspace=orbit",
    "build:shared": "npm run build --workspace=shared",
    "start": "npm run start --workspace=orbitserver",
    "start:cluster": "npm run start:cluster --workspace=orbitserver",
    "sync-indexes": "npm run sync-indexes --workspace=orbitserver",
    "seed": "npm run seed --workspace=orbitserver",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:server": "npm run test --workspace=orbitserver",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "check-db": "npm run build:shared && npm run check-db -w orbitserver",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1"
  },
  "lint-staged": {
    "orbitserver/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --config orbitserver/eslint.config.js",
      "prettier --write"
    ],
    "orbit/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --config orbit/eslint.config.js",
      "prettier --write"
    ],
    "shared/**/*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
