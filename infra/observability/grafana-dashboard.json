{
  "title": "Orbit — API & Queues",
  "panels": [
    {
      "title": "HTTP Requests / sec",
      "type": "graph",
      "targets": [{ "expr": "sum(rate(http_requests_total[1m]))" }]
    },
    {
      "title": "HTTP p95 latency",
      "type": "graph",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))" }]
    },
    {
      "title": "Socket connections active",
      "type": "stat",
      "targets": [{ "expr": "socket_connections_active" }]
    },
    {
      "title": "BullMQ jobs",
      "type": "graph",
      "targets": [{ "expr": "bullmq_jobs_completed_total" }, { "expr": "bullmq_jobs_failed_total" }]
    },
    {
      "title": "Mongo slow queries",
      "type": "graph",
      "targets": [{ "expr": "mongo_slow_queries_total" }]
    }
  ]
}
